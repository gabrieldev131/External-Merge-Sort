package gerenciador.controller.ordenar;

import gerenciador.model.actions.edicaoDeArquivos.manipularArquivo.ArquivoCliente;
import gerenciador.model.cliente.Cliente;

import java.io.File;
import java.io.IOException;
import java.util.*;

public class ExternalSort extends AbstractFileSorter {

    public static final int TAMANHO_BUFFER = 100000;

    private final ArquivoCliente arquivoCliente = ArquivoClienteFactory.criarArquivoCliente();
    private final ArquivoCliente arquivoClienteTemp = ArquivoClienteFactory.criarArquivoCliente();

    private ClienteComparatorStrategy estrategiaOrdenacao = new NomeComparator();

    public void setEstrategiaOrdenacao(ClienteComparatorStrategy estrategia) {
        this.estrategiaOrdenacao = estrategia;
    }

    @Override
    protected List<String> dividirEOrdenar(String arquivoEntrada) throws IOException {
        List<String> arquivosTemporarios = new ArrayList<>();
        arquivoCliente.abrirArquivo(arquivoEntrada, "leitura", Cliente.class);

        int contadorArquivo = 0;

        while (true) {
            List<Cliente> buffer = lerEOrdenarBuffer();
            if (buffer.isEmpty()) break;

            String nomeArquivoTemp = gerarNomeArquivoTemp(contadorArquivo++);
            salvarBlocoOrdenado(buffer, nomeArquivoTemp);
            arquivosTemporarios.add(nomeArquivoTemp);
        }

        arquivoCliente.fechaArquivo();
        return arquivosTemporarios;
    }

    private List<Cliente> lerEOrdenarBuffer() throws IOException {
        List<Cliente> clientesLidos = arquivoCliente.leiaDoArquivo(TAMANHO_BUFFER);
        if (clientesLidos.isEmpty()) return Collections.emptyList();

        clientesLidos.sort(estrategiaOrdenacao.getComparator());
        return clientesLidos;
    }

    private String gerarNomeArquivoTemp(int contador) {
        return "temp_" + contador + ".txt";
    }

    @Override
    protected String mesclarArquivos(List<String> arquivosTemporarios, String arquivoSaida) throws IOException {
        validarArquivosTemporarios(arquivosTemporarios);
        MergeCommand mergeCommand = new MergeFilesCommand();

        while (arquivosTemporarios.size() > 1) {
            arquivosTemporarios = mesclarListaDeArquivos(arquivosTemporarios, mergeCommand);
        }

        return arquivosTemporarios.get(0);
    }

    private void validarArquivosTemporarios(List<String> arquivosTemporarios) {
        if (arquivosTemporarios == null || arquivosTemporarios.isEmpty()) {
            throw new IllegalArgumentException("Nenhum arquivo temporário foi fornecido.");
        }
    }

    private List<String> mesclarListaDeArquivos(List<String> arquivosTemporarios, MergeCommand mergeCommand) throws IOException {
        List<String> arquivosMesclados = new ArrayList<>();

        for (int i = 0; i < arquivosTemporarios.size(); i += 2) {
            String arquivo1 = arquivosTemporarios.get(i);
            String arquivo2 = (i + 1 < arquivosTemporarios.size()) ? arquivosTemporarios.get(i + 1) : null;

            String arquivoMesclado = gerarNomeArquivoMerge();
            mergeCommand.execute(arquivo1, arquivo2, arquivoMesclado);

            arquivosMesclados.add(arquivoMesclado);
        }

        return arquivosMesclados;
    }

    private String gerarNomeArquivoMerge() {
        return "temp_merge_" + System.nanoTime() + ".txt";
    }
}
